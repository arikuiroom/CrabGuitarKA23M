{
  "name": "crab-guitar-ka23m",
  "version": "0.18.0",
  "private": true,
  "type": "module",
  "description": "A six-string Kani Guitar Web Audio instrument.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs --watch",
    "preview": "node scripts/serve.mjs",
    "test": "npm run test:build && npm run test:free && npm run test:audio && npm run test:sprites",
    "test:build": "node --test tests/build/*.test.mjs",
    "test:free": "node --test tests/free/*.test.mjs",
    "test:audio": "node tests/audio/test-audio.mjs",
    "verify:baseline": "node scripts/verify-baseline.mjs",
    "test:sprites": "node --test tests/sprites/*.test.mjs"
  }
}
